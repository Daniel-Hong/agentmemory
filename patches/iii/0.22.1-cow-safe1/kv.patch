+            acknowledged.await.unwrap();
+            let (old_stop, old_rx) = tokio::sync::watch::channel(false);
+            let mut old = Box::pin(BuiltinKvStore::save_loop(
+                Arc::clone(&kv.store), Arc::clone(&kv.dirty), Arc::clone(&kv.save_loop_gate), 3_600_000,
