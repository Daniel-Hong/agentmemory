+    async fn wait_for_saved_value(path: &Path, key: &str, expected: Value) {
+        tokio::time::timeout(std::time::Duration::from_secs(5), async {
+            loop {
+                match std::fs::read(path) {
+                    Ok(bytes) => {
+                        let archived = rkyv::from_bytes::<KeyStorage, rkyv::rancor::Error>(&bytes).unwrap();
+                        let stored: IndexMap<String, Value> = serde_json::from_str(&archived.0).unwrap();
