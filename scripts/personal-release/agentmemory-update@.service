[Unit]
Description=Approved AgentMemory update job %i
# Intentionally independent of agentmemory.service, which the reviewed kit stops.

[Service]
Type=oneshot
# The transaction keeps its reviewed per-phase bounds; the controller must survive it.
TimeoutStartSec=0
User=root
Group=root
UMask=0077
WorkingDirectory=/
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/agentmemory-update-runner --run-job %i
StandardInput=null
StandardOutput=null
StandardError=journal
